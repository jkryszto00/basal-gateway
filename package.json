{
  "name": "basal-gateway",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:up": "docker compose up -d postgres redis",
    "db:generate": "bun --filter @basal/db generate",
    "db:migrate": "bun --filter @basal/db migrate",
    "admin": "bun run --cwd apps/cli admin",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "mock": "bun run --cwd apps/mock start"
  },
  "devDependencies": {
    "prettier": "^3",
    "turbo": "^2.11.7",
    "typescript": "^5"
  }
}
