# Postgres and Redis (docker compose up -d postgres redis)
DATABASE_URL=postgres://basal:basal@localhost:5432/basal
REDIS_URL=redis://localhost:6379

# ---- gateway ----
# Public model name -> inference server speaking the basal API (`bun run mock` serves made-up answers on :8000).
# basal-rs: "path":"/v1/basal" (and "model" when one process serves several models); basal-serve: the default path
# /v1/systemone. "token" is optional: sent as a bearer token, e.g. a Modal proxy token for inference/modal_app.py.
# A model family the gateway does not know yet (omni, 2.0): "api":"passthrough", "maxBodyBytes" for media inputs.
UPSTREAMS={"basal-1.5":{"url":"http://localhost:8000","path":"/v1/basal","maxInFlight":64}}
# docker compose: the gateway container uses UPSTREAMS_DOCKER (default: the mock or basal-rs container of the profile)
UPSTREAMS_DOCKER=
# Model of requests without "model"; default: the first one in UPSTREAMS
DEFAULT_MODEL=
GATEWAY_PORT=8787
# Start of new API keys (2-16 of a-z, 0-9, _); existing keys keep working after a change
API_KEY_PREFIX=bg_live_
# Per organization over all its API keys (each key also has its own limits, default 60/min and 8 parallel)
ORG_RPM_LIMIT=120
ORG_CONCURRENCY_LIMIT=16
# Requests per UTC day per organization; 0 = no daily limit
ORG_DAILY_REQUESTS=0

# ---- web (dashboard) ----
APP_NAME=basal gateway
# Who may create an account: open (default) or closed; optionally only some email domains, e.g. acme.com,acme.pl
SIGNUP_MODE=open
SIGNUP_ALLOWED_DOMAINS=
BETTER_AUTH_SECRET=<openssl rand -hex 32>
BETTER_AUTH_URL=http://localhost:3000
GATEWAY_PUBLIC_URL=http://localhost:8787
# Where the dashboard reaches the gateway for its model list, when not the public URL (e.g. http://gateway:8787)
GATEWAY_INTERNAL_URL=
# Header with the visitor's IP for rate limits: cf-connecting-ip behind Cloudflare, x-forwarded-for behind most proxies
CLIENT_IP_HEADER=x-forwarded-for

# Email: SMTP (smtp://user:pass@host:587, smtps://...:465) or Resend; without either, emails (confirmation and reset
# links) are printed to the web app log
SMTP_URL=
RESEND_API_KEY=
EMAIL_FROM=basal gateway <noreply@example.com>
# false: no email confirmation, accounts work right after sign up (installs that cannot send email)
EMAIL_VERIFICATION=true
# Refuse passwords found in breaches (haveibeenpwned.com, k-anonymity); false for installs without internet access
HIBP_ENABLED=true

# Optional: Cloudflare Turnstile on sign up. These are Cloudflare's test keys (always pass); leave both empty to turn
# it off.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Optional: GitHub / Google sign in; each provider is shown when both its values are set. OAuth callback URLs:
#   <BETTER_AUTH_URL>/api/auth/callback/github   (github.com/settings/developers -> OAuth Apps)
#   <BETTER_AUTH_URL>/api/auth/callback/google   (Google Cloud console -> Credentials -> OAuth client ID, Web)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
